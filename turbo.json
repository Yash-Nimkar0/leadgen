{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "AUTH_SECRET", "NEXTAUTH_URL", "OPENAI_API_KEY", "REDDIT_LIVE_ENABLED", "REDDIT_AUTHORIZED", "REDDIT_USER_AGENT", "REDDIT_ACCESS_TOKEN", "REDDIT_CLIENT_ID", "REDDIT_CLIENT_SECRET", "NEXT_PUBLIC_APP_URL", "OPENAI_MODEL", "RESEND_API_KEY", "EMAIL_FROM", "TEST_EMAIL", "GEMINI_API_KEY", "GEMINI_MODEL", "GEMINI_EVAL_DELAY_MS", "LLM_PRIMARY_PROVIDER", "LLM_FALLBACK_PROVIDERS", "LLM_ROUTING_POLICY", "GROQ_API_KEY", "GROQ_MODEL", "XAI_API_KEY", "XAI_MODEL", "SOURCE_PROVIDER", "EXTERNAL_SOURCE_ENABLED", "EXTERNAL_SOURCE_BASE_URL", "EXTERNAL_SOURCE_API_KEY", "EXTERNAL_SOURCE_PROVIDER", "LLM_VOCAB_PROVIDER", "OPENAI_VOCAB_MODEL"],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
