generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KeywordType {
  PROBLEM
  COMPETITOR
  SOLUTION
  GENERAL
}

enum IntentType {
  ACTIVE_PURCHASE
  ALTERNATIVE_SEEKING
  RECOMMENDATION_REQUEST
  PROBLEM_AWARE
  SOLUTION_RESEARCH
  COMPETITOR_DISSATISFACTION
  COMPARISON
  PASSIVE_DISCUSSION
  LOW_VALUE
  IRRELEVANT
}

enum AlertStatus {
  PENDING
  SENT
  FAILED
}

enum AlertChannel {
  EMAIL
  SLACK
  TELEGRAM
}

enum ProjectLeadStatus {
  NEW
  VIEWED
  DISMISSED
}

enum NotificationFrequency {
  REALTIME
  DAILY
}

enum SourceType {
  SUBREDDIT
}

enum IngestionRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum RateLimitAction {
  LOGIN
  REGISTER
}

model RateLimitAttempt {
  id         String           @id @default(uuid())
  identifier String
  action     RateLimitAction
  createdAt  DateTime         @default(now())

  @@index([identifier, action, createdAt])
}

model User {
  id          String           @id @default(uuid())
  email       String           @unique
  password    String
  projects    Project[]
  preferences UserPreference?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserPreference {
  id                     String                @id @default(uuid())
  userId                 String                @unique
  user                   User                  @relation(fields: [userId], references: [id])
  minimumIntentScore     Int                   @default(70)
  notificationFrequency  NotificationFrequency @default(REALTIME)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
}

model Project {
  id                 String            @id @default(uuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id])
  name               String
  productDescription String
  keywords           Keyword[]
  sources            MonitoredSource[]
  leads              ProjectLead[]
  ingestionRuns      IngestionRun[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  
  @@index([userId])
}

model Keyword {
  id        String      @id @default(uuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id])
  keyword   String
  type      KeywordType
  createdAt DateTime    @default(now())
  
  @@index([projectId])
}

model MonitoredSource {
  id               String      @id @default(uuid())
  projectId        String
  project          Project     @relation(fields: [projectId], references: [id])
  sourceType       SourceType  @default(SUBREDDIT)
  sourceIdentifier String
  enabled          Boolean     @default(true)
  createdAt        DateTime    @default(now())
  
  @@index([projectId])
}

model RedditPost {
  id               String        @id @default(uuid())
  externalId       String        @unique
  sourceUrl        String
  title            String
  body             String?
  authorIdentifier String
  subreddit        String
  publishedAt      DateTime
  discoveredAt     DateTime      @default(now())
  contentHash      String
  leads            ProjectLead[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  
  @@index([publishedAt])
  @@index([contentHash])
}

enum LeadFeedback {
  NONE
  GOOD
  BAD
  NOT_RELEVANT
}

enum LeadOutcome {
  NONE
  CONTACTED
  CONVERTED
}

model ProjectLead {
  id           String             @id @default(uuid())
  projectId    String
  project      Project            @relation(fields: [projectId], references: [id])
  redditPostId String
  redditPost   RedditPost         @relation(fields: [redditPostId], references: [id])
  analysis     Analysis?
  alerts       Alert[]
  discoveredAt DateTime           @default(now())
  status       ProjectLeadStatus  @default(NEW)
  feedback     LeadFeedback       @default(NONE)
  outcome      LeadOutcome        @default(NONE)
  
  @@unique([projectId, redditPostId])
  @@index([projectId])
  @@index([redditPostId])
  @@index([status])
  @@index([feedback])
  @@index([outcome])
}

model Analysis {
  id                 String       @id @default(uuid())
  projectLeadId      String       @unique
  projectLead        ProjectLead  @relation(fields: [projectLeadId], references: [id])
  model              String
  modelVersion       String
  relevanceScore     Int
  intentScore        Int
  finalScore         Int
  intentType         IntentType
  problemSummary     String?
  matchedKeywords    String[]
  matchedCompetitors String[]
  buyingStage        String
  summary            String
  whyItMatters       String
  recommendedPriority String
  createdAt          DateTime     @default(now())
  
  @@index([intentScore])
  @@index([intentType])
}

model Alert {
  id            String       @id @default(uuid())
  projectLeadId String
  projectLead   ProjectLead  @relation(fields: [projectLeadId], references: [id])
  channel           AlertChannel
  status            AlertStatus  @default(PENDING)
  sentAt            DateTime?
  attemptCount      Int          @default(0)
  lastAttemptAt     DateTime?
  failureReason     String?
  providerMessageId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  
  @@unique([projectLeadId, channel])
  @@index([status])
}

model IngestionRun {
  id              String              @id @default(uuid())
  projectId       String?
  project         Project?            @relation(fields: [projectId], references: [id])
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  status          IngestionRunStatus  @default(RUNNING)
  postsDiscovered Int                 @default(0)
  postsFiltered   Int                 @default(0)
  postsClassified Int                 @default(0)
  errorDetails    String?
  
  @@index([projectId])
  @@index([startedAt])
}
