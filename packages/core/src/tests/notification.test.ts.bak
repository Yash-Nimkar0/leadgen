import { describe, it, expect, beforeEach, afterAll, beforeAll } from 'vitest';
import { PrismaClient, AlertStatus, AlertChannel, ProjectLeadStatus, IntentType } from '@prisma/client';
import { NotificationService } from '../notification/NotificationService';
import { MockNotificationProvider } from '../providers/notification/mock-notification';

const prisma = new PrismaClient();
const mockProvider = new MockNotificationProvider();
const notificationService = new NotificationService(prisma, mockProvider);

describe('NotificationService', () => {
  let userId: string;
  let projectId: string;

  beforeAll(async () => {
    // Setup base data
    const user = await prisma.user.create({
      data: {
        email: `test-${Date.now()}@example.com`,
        password: 'password',
        preferences: {
          create: {
            minimumIntentScore: 80,
            notificationFrequency: 'REALTIME'
          }
        }
      }
    });
    userId = user.id;

    const project = await prisma.project.create({
      data: {
        name: 'Test Project',
        productDescription: 'Testing',
        userId: userId
      }
    });
    projectId = project.id;
  });

  afterAll(async () => {
    // Cleanup
    await prisma.alert.deleteMany({});
    await prisma.analysis.deleteMany({});
    await prisma.projectLead.deleteMany({});
    await prisma.redditPost.deleteMany({});
    await prisma.project.deleteMany({ where: { id: projectId } });
    await prisma.userPreference.deleteMany({ where: { userId } });
    await prisma.user.deleteMany({ where: { id: userId } });
    await prisma.$disconnect();
  });

  beforeEach(async () => {
    mockProvider.clear();
    await prisma.alert.deleteMany({});
    await prisma.analysis.deleteMany({});
    await prisma.projectLead.deleteMany({});
    await prisma.redditPost.deleteMany({});
  });

  async function createLeadWithScore(score: number, status = ProjectLeadStatus.NEW, intentType = IntentType.ACTIVE_PURCHASE) {
    const post = await prisma.redditPost.create({
      data: {
        externalId: `ext-${Math.random()}`,
        sourceUrl: 'http://reddit.com/r/test',
        title: 'Test Post',
        authorIdentifier: 'user1',
        subreddit: 'test',
        publishedAt: new Date(),
        contentHash: `hash-${Math.random()}`
      }
    });

    const lead = await prisma.projectLead.create({
      data: {
        projectId,
        redditPostId: post.id,
        status
      }
    });

    await prisma.analysis.create({
      data: {
        projectLeadId: lead.id,
        model: 'test',
        modelVersion: '1',
        relevanceScore: 100,
        intentScore: score,
        finalScore: score,
        intentType,
        buyingStage: 'AWARENESS',
        summary: 'Test',
        whyItMatters: 'Test',
        recommendedPriority: 'HIGH'
      }
    });

    return lead.id;
  }

  it('should notify if intent score is above threshold', async () => {
    const leadId = await createLeadWithScore(85);
    const result = await notificationService.processLead(leadId);

    expect(result).toBe(true);
    expect(mockProvider.sentEmails.length).toBe(1);

    const alert = await prisma.alert.findFirst({ where: { projectLeadId: leadId } });
    expect(alert).toBeDefined();
    expect(alert?.status).toBe(AlertStatus.SENT);
    expect(alert?.attemptCount).toBe(1);
  });

  it('should not notify if intent score is below threshold', async () => {
    const leadId = await createLeadWithScore(79);
    const result = await notificationService.processLead(leadId);

    expect(result).toBe(false);
    expect(mockProvider.sentEmails.length).toBe(0);

    const alert = await prisma.alert.findFirst({ where: { projectLeadId: leadId } });
    expect(alert).toBeNull();
  });

  it('should not notify if lead is dismissed', async () => {
    const leadId = await createLeadWithScore(95, ProjectLeadStatus.DISMISSED);
    const result = await notificationService.processLead(leadId);

    expect(result).toBe(false);
    expect(mockProvider.sentEmails.length).toBe(0);
  });

  it('should not notify if intent is irrelevant', async () => {
    const leadId = await createLeadWithScore(95, ProjectLeadStatus.NEW, IntentType.IRRELEVANT);
    const result = await notificationService.processLead(leadId);

    expect(result).toBe(false);
    expect(mockProvider.sentEmails.length).toBe(0);
  });

  it('idempotency: should not send twice for the same lead', async () => {
    const leadId = await createLeadWithScore(90);
    
    // First attempt
    const result1 = await notificationService.processLead(leadId);
    expect(result1).toBe(true);
    expect(mockProvider.sentEmails.length).toBe(1);

    // Second attempt should fail to claim or send
    const result2 = await notificationService.processLead(leadId);
    expect(result2).toBe(false);
    expect(mockProvider.sentEmails.length).toBe(1); // Still 1
  });

  it('should handle provider failure and allow retry', async () => {
    const leadId = await createLeadWithScore(90);
    
    // Setup mock to fail
    mockProvider.shouldFail = true;
    mockProvider.transientFailure = true;
    mockProvider.failReason = "API timeout";

    const result1 = await notificationService.processLead(leadId);
    expect(result1).toBe(false);
    expect(mockProvider.sentEmails.length).toBe(0);

    let alert = await prisma.alert.findFirst({ where: { projectLeadId: leadId } });
    expect(alert?.status).toBe(AlertStatus.FAILED);
    expect(alert?.failureReason).toBe("API timeout");
    expect(alert?.attemptCount).toBe(1);

    // Now fix mock and retry
    mockProvider.shouldFail = false;
    const result2 = await notificationService.processLead(leadId);
    expect(result2).toBe(true);
    expect(mockProvider.sentEmails.length).toBe(1);

    alert = await prisma.alert.findFirst({ where: { projectLeadId: leadId } });
    expect(alert?.status).toBe(AlertStatus.SENT);
    expect(alert?.attemptCount).toBe(2);
  });
  
  it('concurrency: should not allow duplicate sends if called simultaneously', async () => {
    const leadId = await createLeadWithScore(90);

    // Run both simultaneously
    const [result1, result2] = await Promise.all([
      notificationService.processLead(leadId),
      notificationService.processLead(leadId)
    ]);

    // One should succeed, one should fail
    expect([result1, result2].filter(r => r === true).length).toBe(1);
    expect([result1, result2].filter(r => r === false).length).toBe(1);
    
    // Only one email should be sent
    expect(mockProvider.sentEmails.length).toBe(1);
    
    // Only one alert created (unique constraint enforced)
    const alerts = await prisma.alert.findMany({ where: { projectLeadId: leadId } });
    expect(alerts.length).toBe(1);
    expect(alerts[0].attemptCount).toBe(1);
  });
});
