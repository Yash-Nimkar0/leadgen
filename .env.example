DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reddit_intent?schema=public"

# Auth (NextAuth or Supabase)
AUTH_SECRET="your-super-secret-key-for-development-only"
AUTH_URL="http://localhost:3000"

# LLM Routing Configuration
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=groq,openai,xai
LLM_ROUTING_POLICY=priority

# Gemini Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# OpenAI Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Groq Configuration
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

# xAI Configuration
XAI_API_KEY=""
XAI_MODEL=""

# Resend Configuration
RESEND_API_KEY="re_your-key-here"
EMAIL_FROM=

# Reddit Integration (For Phase 7)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
