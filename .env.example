DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reddit_intent?schema=public"

# Auth (NextAuth or Supabase)
AUTH_SECRET="your-super-secret-key-for-development-only"
AUTH_URL="http://localhost:3000"

# LLM Routing Configuration
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=groq,openai,xai
LLM_ROUTING_POLICY=priority

# Gemini Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# OpenAI Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Groq Configuration
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

# xAI Configuration
XAI_API_KEY=""
XAI_MODEL=""

# Resend Configuration
RESEND_API_KEY="re_your-key-here"
EMAIL_FROM=

# Reddit Integration
# Create a "script" type app at https://www.reddit.com/prefs/apps to get these two.
# This uses Reddit's free, non-commercial developer tier (client_credentials grant,
# no Reddit account password needed) - see docs/reddit-data-strategy.md for what
# that does and does not authorize.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="leadgen-private-test/1.0 (by u/your-reddit-username)"
# Both must be "true" to turn on live ingestion (still gated off by default):
REDDIT_LIVE_ENABLED="false"
REDDIT_AUTHORIZED="false"

# Source Provider Configuration
SOURCE_PROVIDER=mock
EXTERNAL_SOURCE_ENABLED=false
EXTERNAL_SOURCE_BASE_URL=
EXTERNAL_SOURCE_API_KEY=
EXTERNAL_SOURCE_PROVIDER=
